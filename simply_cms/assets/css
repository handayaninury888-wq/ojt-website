* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background-color: #f5f7fa;
    color: #333;
    line-height: 1.6;
}

/* Header */
header {
    background-color: #0d4a7f;
    color: white;
    padding: 1rem 2rem;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.header-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo h1 {
    font-size: 1.5rem;
    font-weight: 600;
}

nav ul {
    display: flex;
    list-style: none;
}

nav ul li {
    margin-left: 1.5rem;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: 500;
    transition: color 0.3s;
}

nav ul li a:hover {
    color: #b3d4ff;
}

/* Main Container */
.container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

.container h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
    color: #0d4a7f;
}

.container p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    color: #555;
}

/* Post Grid */
.post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
}

.post-card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
}

.post-card:hover {
    transform: translateY(-5px);
}

.post-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
}

.placeholder-image {
    width: 100%;
    height: 200px;
    background: #e0e0e0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    color: #888;
}

.post-content {
    padding: 1.5rem;
}

.post-content h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: #0d4a7f;
}

.post-date {
    font-size: 0.85rem;
    color: #777;
    margin-bottom: 0.75rem;
}

.post-excerpt {
    margin-bottom: 1rem;
    color: #555;
    font-size: 0.95rem;
}

.read-more {
    display: inline-block;
    color: #0d4a7f;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
}

.read-more:hover {
    color: #007bff;
    text-decoration: underline;
}

/* Footer */
footer {
    background-color: #0d4a7f;
    color: white;
    text-align: center;
    padding: 1.5rem;
    margin-top: 3rem;
    font-size: 0.9rem;
}

.footer-container p {
    margin: 0.5rem 0;
}

/* Responsive */
@media (max-width: 768px) {
    .header-container {
        flex-direction: column;
        text-align: center;
    }

    nav ul {
        margin-top: 1rem;
        flex-wrap: wrap;
        justify-content: center;
    }

    nav ul li {
        margin: 0.5rem;
    }

    .container h1 {
        font-size: 2rem;
    }

    .post-grid {
        grid-template-columns: 1fr;
    }
}

/* No Posts Message */
.no-posts {
    text-align: center;
    font-size: 1.1rem;
    color: #777;
    padding: 2rem;
}

.no-posts a {
    color: #0d4a7f;
    text-decoration: underline;
}

.post-detail .single-post {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

.post-detail h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    color: #0d4a7f;
}

.post-meta {
    color: #777;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
}

.post-image {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
    border-radius: 8px;
    margin-bottom: 1.5rem;
}

.post-body {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #333;
    margin-bottom: 1.5rem;
}

.back-link {
    display: inline-block;
    color: #0d4a7f;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s;
}

.back-link:hover {
    color: #007bff;
    text-decoration: underline;
}